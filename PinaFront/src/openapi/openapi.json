  "components": {
    "schemas": {
      "RegistrationRequest": {
        "required": [
          "codiceFiscale",
          "cognome",
          "dataNascita",
          "email",
          "luogoDiNascita",
          "nome",
          "password"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cognome": {
            "type": "string"
          },
          "codiceFiscale": {
            "maxLength": 2147483647,
            "minLength": 16,
            "type": "string"
          },
          "dataNascita": {
            "type": "string",
            "format": "date"
          },
          "luogoDiNascita": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 2147483647,
            "minLength": 8,
            "pattern": "^(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,}$",
            "type": "string"
          }
        }
      },
      "AuthenticationRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthenticationResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "OperaRequest": {
        "required": [
          "anno",
          "tecnica",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "anno": {
            "type": "integer",
            "format": "int32"
          },
          "tecnica": {
            "type": "string"
          }
        }
      },
      "ArtistaRequest": {
        "required": [
          "cognome",
          "dataDiNascita",
          "luogoDiNascita",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cognome": {
            "type": "string"
          },
          "dataDiNascita": {
            "type": "string",
            "format": "date"
          },
          "luogoDiNascita": {
            "type": "string"
          },
          "dataDiMorte": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "AreaRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Artista": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "cognome": {
            "type": "string"
          },
          "dataDiNascita": {
            "type": "string",
            "format": "date"
          },
          "luogoDiNascita": {
            "type": "string"
          },
          "dataDiMorte": {
            "type": "string",
            "format": "date"
          },
          "opere": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Opera"
            }
          },
          "immagine": {
            "type": "string"
          }
        }
      },
      "Opera": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
